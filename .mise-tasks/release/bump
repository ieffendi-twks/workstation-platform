#!/usr/bin/env bash
# .mise/tasks/release/bump
#MISE description="Create a SemVer release commit, changelog, and annotated tag"
#MISE dir="{{config_root}}"
#USAGE flag "--increment <increment>" help="Force MAJOR, MINOR, or PATCH"
#USAGE flag "--version <version>" help="Break-glass exact stable SemVer, for example 2.0.0"
#USAGE flag "--dry-run" help="Preview without changing files, commits, or tags"
set -euo pipefail

fail() {
    printf 'release:bump: %s\n' "$1" >&2
    exit 1
}

[ "$(git branch --show-current)" = "main" ] || fail "run releases on main"
git diff --quiet && git diff --cached --quiet || fail "commit or stash all changes first"

git remote get-url origin >/dev/null 2>&1 || fail "origin remote is required"
git fetch origin main --tags
[ "$(git rev-list --count HEAD..origin/main)" = "0" ] || fail "main is behind origin/main; pull or rebase first"

increment=${usage_increment:-}
exact_version=${usage_version:-}
dry_run=${usage_dry_run:-false}

[ -z "$increment" ] || [ -z "$exact_version" ] || fail "use --increment or --version, not both"
case $increment in
    "" | MAJOR | MINOR | PATCH) ;;
    *) fail "--increment must be MAJOR, MINOR, or PATCH" ;;
esac
if [ -n "$exact_version" ] && ! printf '%s\n' "$exact_version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    fail "--version must be stable SemVer, for example 2.0.0"
fi

arguments=(--yes --changelog)
[ "$dry_run" != "true" ] || arguments+=(--dry-run)

# Forced increments and exact versions must work even when there are no new
# eligible Conventional Commits. Automatic bumps intentionally do not.
if [ -n "$increment" ]; then
    arguments+=(--increment "$increment" --allow-no-commit)
elif [ -n "$exact_version" ]; then
    arguments+=(--allow-no-commit "$exact_version")
fi

cz bump "${arguments[@]}"

if [ "$dry_run" = "true" ]; then
    exit 0
fi

new_version=$(tr -d '[:space:]' < .version)
[ "$(git cat-file -t "$new_version")" = "tag" ] || fail "release tag $new_version is not annotated"

printf '\nCreated annotated release tag %s.\n' "$new_version"
printf 'Review with: git show --stat --oneline HEAD && git show %s\n' "$new_version"
printf '%s\n' "Publish with: mise run release:publish"